<!DOCTYPE html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <title>Bilješke</title>
  </head>

  <body>
    <h1>Projekt 2: Privatne bilješke</h1>

    <h3>Prijavljeni ste kao <%= current_user.user_email %></h3>

    <p>broj spremljenih bilješki: <%- current_user.note_num %></p>

    <button onclick="logout()">Log out</button>
    <hr />

    <p>Nova bilješka</p>
    <input type="text" id="new_note_name" required />
    <input type="text" id="new_note_text" required />
    <button onclick="create_note()">Pohrani</button>

    <hr />

    <p>
      Upute: SQL umetanje - upit UNION. U normalnom slučaju korisnik bi
      pretražio vlastite bilješke prema imenu bilješke. Maliciozni korisnik može
      ovim upitom dobiti popis svih bilješki, a ne samo svojih, time i popis
      korisnika.
    </p>
    <p>Maliciozni upit: ' UNION SELECT * FROM notes --</p>
    <label>Omogućen SQLinjection</label>
    <input type="checkbox" id="sql_allow" />

    <p>Potražite bilješku upisavši njezino ime</p>
    <input type="text" id="note_name" />
    <button onclick="search_note()">Pretraži</button>

    <div id="search_note_res"></div>

    <hr />
    <br />

    <p>
      Upute: CSRF. Niže je ponuđena mogućnost brisanja svih bilježaka prijavljenog korisnika.
      Ovaj upit moguće je pozvati s druge maliciozne stranice, ali prvo je
      potrebno omogućiti CSRF napad primjenom CSRF postavke i unutar preglednika kolačiće trećih strana. Maliciozna stranica
      može se simulirati lokalnim pokretanjem skripte
      src/maliciozno/mal_stranica.ts, paziti da se maliciozni server otvara u
      istom pregledniku kao i Render stranica. Skripta se pokreće naredbom:
    </p>
    <p>npx tsx ./src/maliciozno/mal_stranica.ts</p>
    <label>Omogućen CSRF napad</label>
    <input type="checkbox" id="csrf_allow" <%= current_user.csrf_allow ? 'checked' : '' %>/>
    <br />
    <button onclick="toggle_csrf()">Primijeni CSRF postavku</button>

    <br />
    <button onclick="delete_all_notes()">Izbriši sve bilješke</button>

    <script>
      async function logout() {
        try {
          response = await fetch("/user/logout", {
            method: "POST",
            credentials: "include",
            headers: { "Content-type": "application/json" },
          });
        } catch (error) {
          console.log(`Failed to logout: ${error}`);
        }

        window.location.reload();
      }

      async function create_note() {
        const note_name = document.getElementById("new_note_name").value;
        const note_text = document.getElementById("new_note_text").value;
        let response;

        try {
          response = await fetch("/note/create", {
            method: "POST",
            body: JSON.stringify({
              name: note_name,
              text: note_text,
            }),
            credentials: "include",
            headers: { "Content-type": "application/json" },
          });
        } catch (error) {
          console.log(`Failed to create the note: ${error}`);
        }

        window.location.reload();
      }

      async function search_note() {
        const allow_sql = document.getElementById("sql_allow").checked;
        const note_name = document.getElementById("note_name").value;
        let response;

        try {
          response = await fetch("/note/search", {
            method: "POST",
            body: JSON.stringify({
              note_name: note_name,
              allow_sql: allow_sql,
            }),
            credentials: "include",
            headers: { "Content-type": "application/json" },
          });
        } catch (error) {
          console.log(`Failed to search for the note: ${error}`);
        }

        let json_response;
        try {
          json_response = await response.json();
        } catch (error) {
          console.log(`JSON error while searching for note: ${error}`);
        }

        const note_div = document.getElementById("search_note_res");
        console.log(json_response);
        note_div.innerHTML = JSON.stringify(json_response);
      }

      async function delete_note(note_name) {
        try {
          await fetch("/note/delete", {
            method: "POST",
            body: JSON.stringify({ note_name: note_name }),
            credentials: "include",
            headers: { "Content-type": "application/json" },
          });
          window.location.reload();
        } catch (error) {
          console.log(`Failed to delete the note: ${error}`);
        }
      }

      async function delete_all_notes() {
        const csrf_token = "<%- current_user.csrf_token %>";
        try {
          await fetch("/note/delete-all", {
            method: "POST",
            credentials: "include",
            headers: {
              "Content-type": "application/json",
              "x-csrf-token": csrf_token,
            },
          });
          window.location.reload();
        } catch (error) {
          console.log(`Failed to delete notes: ${error}`);
        }
      }

      async function toggle_csrf() {
        const allow_csrf = document.getElementById("csrf_allow").checked;

        try {
          await fetch("/vulnerability", {
            method: "POST",
            credentials: "include",
            body: JSON.stringify({ allow_csrf: allow_csrf }),
            headers: { "Content-type": "application/json" },
          });
          window.location.reload();
        } catch (error) {
          console.log(`Failed to delete notes: ${error}`);
        }
      }
    </script>
  </body>
</html>
